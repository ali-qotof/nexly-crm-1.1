# انسخ هذا الملف إلى .env ولا ترفعه أبدًا إلى Git

# اتصال قاعدة البيانات (Supabase PostgreSQL في الإنتاج، PostgreSQL محلي أثناء التطوير)
DATABASE_URL=postgresql+psycopg://nexly:nexly@localhost:5432/nexly

# سر توقيع الجلسات/JWT — يجب أن يكون عشوائيًا وطويلًا (32+ حرفًا) في الإنتاج
NEXLY_SECRET=change-me-in-production-use-a-long-random-value

# مدة صلاحية الجلسة بالدقائق
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

APP_ENV=development
APP_VERSION=0.1.0
GIT_COMMIT=local

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# سر مشترك للتحقق من Webhooks الواردة (Integration Layer)
WEBHOOK_SHARED_SECRET=change-me
